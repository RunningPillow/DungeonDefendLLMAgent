{
  "name": "dungeon-defend-llm-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Balance tooling for the game Dungeon Defend: a PvP simulator that runs the game's real combat code, exposed to LLM agents.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sim": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "agent": "tsx src/agent/cli.ts",
    "eval": "tsx src/eval/run.ts",
    "test": "tsx --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
