# Copy to .env and fill in. .env is never committed.

# Folder with the game's Firebase Functions (must contain the compiled lib/). Relative to this repo.
DD_FUNCTIONS_DIR=../DungeonDefend/FirebaseFunctions/functions

# Firebase project the game data lives in.
DD_FIREBASE_PROJECT=

# Uid of a character whose heroes are used as "bodies" for simulated teams (a staging test character).
DD_TEMPLATE_CHARACTER=

# Optional. If unset, the single *_application_default_credentials.json in ~/.config/firebase is used.
# GOOGLE_APPLICATION_CREDENTIALS=

# For the agent (npm run agent): key for the Claude API, created at https://platform.claude.com/settings/keys
# Not needed by the simulator or the MCP server.
ANTHROPIC_API_KEY=